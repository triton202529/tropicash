# Tropicash Environment Variables
# Copy to .env.local for development. Never commit secrets (only this template is tracked).
# Canonical documentation: docs/deployment/PRODUCTION_DEPLOYMENT.md

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_MODE=sandbox
NEXT_PUBLIC_WITHDRAWAL_AUTOMATED_PAYOUT=false
NEXT_PUBLIC_OAUTH_CODE_ISSUANCE_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_SENDER_EMAIL=
PAYPAL_PAYOUT_CURRENCY=USD
TROPICASH_REQUIRE_APPROVED_KYC=true
OAUTH_CODE_ISSUANCE_ENABLED=false
NODE_ENV=development
